#!/bin/bash
# Instalador automático de Xibo CMS en Ubuntu Server 24.04
# Autor: Pablo + ChatGPT :)

set -e

echo "=== ACTUALIZANDO SISTEMA ==="
sudo apt update && sudo apt upgrade -y

echo "=== INSTALANDO DEPENDENCIAS ==="
sudo apt install -y docker.io docker-compose git curl

echo "=== HABILITANDO DOCKER ==="
sudo systemctl enable docker
sudo systemctl start docker
sudo usermod -aG docker $USER

echo "=== DESCARGANDO XIBO-DOCKER ==="
if [ ! -d "xibo-docker" ]; then
    git clone https://github.com/xibosignage/xibo-docker.git
fi
cd xibo-docker

echo "=== CONFIGURANDO ENTORNO ==="
if [ ! -f config.env ]; then
    cp config.env.template config.env
    # Reemplazar valores por defecto
    sed -i 's/CMS_PORT=8080/CMS_PORT=8080/' config.env
    sed -i 's/MYSQL_PASSWORD=/MYSQL_PASSWORD=MiClaveSegura123/' config.env
    sed -i 's/MYSQL_ROOT_PASSWORD=/MYSQL_ROOT_PASSWORD=RootClave321/' config.env
    sed -i 's/CMS_ADMIN_PASSWORD=/CMS_ADMIN_PASSWORD=admin123/' config.env
fi

echo "=== LEVANTANDO SERVICIOS CON DOCKER ==="
docker-compose up -d

echo "=== INSTALACIÓN FINALIZADA ==="
IP=$(hostname -I | awk '{print $1}')
echo "Accede a Xibo CMS en: http://$IP:8080"
echo "Usuario: xibo_admin"
echo "Contraseña: admin123 (puedes cambiarla luego)"
