#!/bin/bash
set -e

echo "🚀 Instalador automático de Xibo CMS en Ubuntu 24.04"
echo "===================================================="

# 1. Actualizar sistema
sudo apt update && sudo apt upgrade -y

# 2. Instalar dependencias
sudo apt install -y docker.io docker-compose git ufw

# 3. Habilitar y arrancar Docker
sudo systemctl enable docker
sudo systemctl start docker

# 4. Descargar Xibo Docker si no existe
if [ ! -d "$HOME/xibo-docker" ]; then
    echo "📥 Descargando repositorio de Xibo..."
    git clone https://github.com/xibosignage/xibo-docker.git ~/xibo-docker
fi

cd ~/xibo-docker

# 5. Configuración inicial (si no existe)
if [ ! -f "config.env" ]; then
    echo "⚙️  Creando archivo config.env..."
    cp config.env.template config.env
    # Aquí podrías modificar valores predeterminados, por ejemplo:
    sed -i 's/WEB_PORT=8080/WEB_PORT=80/' config.env
fi

# 6. Levantar los contenedores
echo "🐳 Iniciando contenedores de Xibo..."
docker-compose up -d

# 7. Configurar firewall
echo "🛡️ Configurando firewall..."
sudo ufw allow 80/tcp
sudo ufw allow 9505/tcp
sudo ufw reload

echo ""
echo "✅ Instalación completada."
echo "Puedes acceder a Xibo en: http://$(hostname -I | awk '{print $1}')"
echo "Usuario inicial: xibo_admin"
echo "Contraseña inicial: xibo_admin"
